  m_Script: {fileID: 11500000, guid: 6885981696ea5bd46a08d5e8f1c977d4, type: 3}
  m_Name: Dialogue_Test
  m_EditorClassIdentifier: Jagara.Runtime::Jagara.Runtime.Narrative.Dialogue.DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: da0b6d5b32ad83a4386f84979d6cdcf6, type: 2}
    text: You sank again. I told you the door was never locked.
  - speaker: {fileID: 11400000, guid: da0b6d5b32ad83a4386f84979d6cdcf6, type: 2}
    text: Carry on, tormented one. Something down here is still awake.
  - speaker: {fileID: 11400000, guid: da0b6d5b32ad83a4386f84979d6cdcf6, type: 2}
    text: The dark settles back into place.
